# ==========================================================
#  Habisite Design Challenge — variables del backend
#
#  Copiar a .env y completar. El .env NO se sube al repo.
#
#  Los nombres van en MAYÚSCULA e inglés a propósito, aunque el
#  resto del código esté en español (ver CLAUDE.md §9): varios de
#  estos los inyecta Railway con ese nombre fijo y renombrarlos a
#  medias sería peor que dejarlos todos con la convención de siempre.
# ==========================================================

# ── Entorno ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos ─────────────────────────────────────────
# En local, el contenedor de Postgres. En Railway se referencia
# el servicio con ${{Postgres.DATABASE_URL}} y no se escribe a mano.
DATABASE_URL=postgresql://habisite:habisite@localhost:5432/habisite_challenge

# ── Google OAuth ──────────────────────────────────────────
# console.cloud.google.com → APIs y servicios → Credenciales
#
# GOOGLE_CLIENT_SECRET es secreto: solo vive acá y en las variables
# de Railway. Nunca en el repo, nunca en un documento, nunca en un chat.
# El secret real empieza con GOCSPX- y tiene ~35 caracteres. Si lo que
# copiaste tiene asteriscos, es el valor enmascarado de la consola: hay
# que crear uno nuevo con "Agregar secreto" y copiarlo en ese momento.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Tiene que coincidir CARÁCTER POR CARÁCTER con la URI de
# redireccionamiento registrada en la consola de Google. Una barra
# de más al final y el login falla con un error que no explica nada.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── Sesión ────────────────────────────────────────────────
# Generar uno nuevo con:  openssl rand -base64 48
# Cambiarlo invalida todas las sesiones abiertas.
JWT_SECRET=
JWT_EXPIRACION=7d

# Vacío en local (el navegador usa el host tal cual).
# En producción: .challenge.habisite.com  — el punto inicial importa,
# es lo que hace que la cookie viaje entre el front y la API.
COOKIE_DOMAIN=
# En local va false porque no hay HTTPS. En producción, true.
COOKIE_SEGURA=false

# ── Front ─────────────────────────────────────────────────
# A dónde vuelve el navegador después del login, y el único origen
# al que la API le habilita CORS con credenciales.
FRONTEND_URL=http://localhost:5173

# ── Reglas del concurso ───────────────────────────────────
# El cierre de entregas se compara siempre contra esta zona horaria,
# nunca contra el reloj del navegador del concursante.
ZONA_HORARIA=America/Argentina/Buenos_Aires
# 30 MB. El tope real lo manda la fila de la tabla `edicion`;
# este valor es el freno de emergencia antes de leer el archivo.
MAX_BYTES_ARCHIVO=31457280

# ── Correo (Resend) ────────────────────────────────────────
# resend.com → API keys. Permiso "Sending access", limitada al dominio
# habisite.com. Es secreta: solo acá y en las variables de Railway.
RESEND_API_KEY=
# Quién envía y a dónde van las respuestas. La casilla existe en
# Cloudflare Email Routing y reenvía a quien atiende las consultas.
CORREO_REMITENTE="Habisite Design Challenge <habisitechallenge@habisite.com>"
CORREO_RESPONDER_A=habisitechallenge@habisite.com

# ── Cloudflare Turnstile ───────────────────────────────────
# El captcha invisible del formulario de inscripción. Esta es la
# clave SECRETA; la site key es pública y la usa el front.
# Para probar en local sin widget: 1x0000000000000000000000000000000AA
# (siempre aprueba) o 2x0000000000000000000000000000000AA (siempre rechaza).
TURNSTILE_SECRET=

# ── WhatsApp ───────────────────────────────────────────────
# El enlace de invitación al grupo. Los correos nunca lo llevan directo:
# pasan por /r/{token}, así se puede cambiar acá sin reenviar nada.
WHATSAPP_URL=

# ── Tarea periódica ────────────────────────────────────────
# Cada cuántos minutos corre la tarea que manda los recordatorios vencidos
# y cierra las entregas. El cierre en sí lo aplica el CierreGuard en cada
# pedido: esto solo define cuánto puede tardar el paso a "entregada".
TAREA_INTERVALO_MINUTOS=30
